#!/usr/bin/env python3
"""Fake ``claude`` CLI for tests: speaks just enough of the Agent SDK stream-json protocol for
``SdkEngine`` to complete a run without a network or a login.

Protocol (claude-agent-sdk 0.2.148):
* ``<cli> -v`` version probe   - _internal/transport/subprocess_cli.py:1144-1161
* argv flags                   - subprocess_cli.py:562-785 (recorded here, one line per run)
* initialize control_request   - _internal/query.py:261-283 (sent), :598-627 (wire), answered with a
  ``control_response`` routed by :318-330
* user message on stdin        - _internal/client.py:176-186 / query.py:863-876
* messages on stdout           - _internal/message_parser.py: system :226, stream_event :343,
  assistant :151, result :308 (``structured_output`` :322)
* stdin EOF ends the run       - query.py:831-861; the CLI exits non-zero after an is_error result

Env: LENSMARK_FAKE_ARGV (append argv line), LENSMARK_FAKE_MODE = ok|error|invalid,
LENSMARK_FAKE_STRUCTURED (path of the structured_output JSON; default proposals/default.json).
"""
import json
import os
import shlex
import sys
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
VERSION = "2.1.251 (Claude Code)"
PROSE = ('Here is my analysis in prose rather than JSON. The deflector sits near the centre and a faint arc '
         'lies about 1.5" to the south; the field star at upper right is bright. I could not produce the object.')


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def main(argv):
    if any(a in ("--version", "-v", "-V") for a in argv):
        print(VERSION)
        return 0
    rec = os.environ.get("LENSMARK_FAKE_ARGV")
    if rec:
        with open(rec, "a", encoding="utf-8") as f:
            f.write(shlex.join(argv).replace("\n", "\\n") + "\n")
    mode = os.environ.get("LENSMARK_FAKE_MODE", "ok")
    model = argv[argv.index("--model") + 1] if "--model" in argv else "claude-fake"
    partial = "--include-partial-messages" in argv
    sid = "fake-" + uuid.uuid4().hex[:8]
    spath = Path(os.environ.get("LENSMARK_FAKE_STRUCTURED") or HERE / "proposals" / "default.json")
    doc = json.loads(spath.read_text(encoding="utf-8"))
    usage = {"input_tokens": 3210, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "output_tokens": 640}
    exit_code = 0

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        t = msg.get("type")
        if t == "control_request":
            rid = msg.get("request_id")
            sub = (msg.get("request") or {}).get("subtype")
            resp = {}
            if sub == "initialize":
                resp = {"commands": [], "output_style": "default", "available_output_styles": ["default"],
                        "models": [{"value": model, "displayName": model}],
                        "account": {"email": "fake@example.invalid", "subscriptionType": "fake"},
                        "pid": os.getpid()}
            out({"type": "control_response", "response": {"subtype": "success", "request_id": rid, "response": resp}})
        elif t == "user":
            out({"type": "system", "subtype": "init", "session_id": sid, "cwd": os.getcwd(), "tools": [],
                 "mcp_servers": [], "model": model, "permissionMode": "bypassPermissions", "apiKeySource": "none",
                 "claude_code_version": "2.1.251", "output_style": "default", "slash_commands": [], "agents": [],
                 "uuid": uuid.uuid4().hex})
            if mode == "error":
                out({"type": "result", "subtype": "error_during_execution", "is_error": True, "duration_ms": 12,
                     "duration_api_ms": 0, "num_turns": 1, "result": "", "session_id": sid, "total_cost_usd": 0.001,
                     "usage": usage, "errors": ["fake error: API Error 529 overloaded"], "uuid": uuid.uuid4().hex})
                exit_code = 1
                continue
            thinking = "Fake reasoning: locate the deflector on the grid image, then the arc, then the masks."
            text = PROSE if mode == "invalid" else json.dumps(doc)
            if partial:
                ev = lambda e: out({"type": "stream_event", "uuid": uuid.uuid4().hex, "session_id": sid,
                                    "event": e, "parent_tool_use_id": None})
                ev({"type": "message_start", "message": {"id": "msg_fake", "role": "assistant", "model": model}})
                ev({"type": "content_block_start", "index": 0, "content_block": {"type": "thinking", "thinking": ""}})
                ev({"type": "content_block_delta", "index": 0, "delta": {"type": "thinking_delta", "thinking": thinking}})
                ev({"type": "content_block_stop", "index": 0})
                ev({"type": "content_block_start", "index": 1, "content_block": {"type": "text", "text": ""}})
                for i in range(0, len(text), 400):
                    ev({"type": "content_block_delta", "index": 1, "delta": {"type": "text_delta", "text": text[i:i + 400]}})
                ev({"type": "content_block_stop", "index": 1})
                ev({"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 640}})
                ev({"type": "message_stop"})
            out({"type": "assistant", "message": {"id": "msg_fake", "type": "message", "role": "assistant", "model": model,
                                                  "content": [{"type": "thinking", "thinking": thinking, "signature": ""},
                                                              {"type": "text", "text": text}],
                                                  "stop_reason": "end_turn", "stop_sequence": None, "usage": usage},
                 "parent_tool_use_id": None, "session_id": sid, "uuid": uuid.uuid4().hex})
            result = {"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1234, "duration_api_ms": 1000,
                      "num_turns": 1, "result": text, "session_id": sid, "total_cost_usd": 0.0123, "usage": usage,
                      "modelUsage": {model: {"inputTokens": 3210, "outputTokens": 640, "costUSD": 0.0123}},
                      "permission_denials": [], "stop_reason": "end_turn", "uuid": uuid.uuid4().hex}
            if mode != "invalid":
                result["structured_output"] = doc
            out(result)
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

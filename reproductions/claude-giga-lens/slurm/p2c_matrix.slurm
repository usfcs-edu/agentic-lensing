#!/bin/bash
#SBATCH -A cosmo_g
#SBATCH -C gpu
#SBATCH -q regular
#SBATCH -t 06:00:00
#SBATCH -N 1
#SBATCH --gpus-per-node=4
#SBATCH -J cgl-p2c
#SBATCH -o slurm-%j.out
# claude-giga-lens P2c: the T2/T3 sampler eval matrix (+ optional PT reference /
# SMC evidence) on ONE 4-A100 node, lane-scheduled (jobs round-robined to 4 GPU
# lanes, each lane runs its jobs sequentially -> all 4 GPUs stay busy; regular
# QOS bills the full 4-GPU node so pack it). The manifest (single source of
# truth) is generated by slurm/gen_p2c_manifest.py.
#
# ACCOUNT: cosmo_g (P2c -> cosmo_g CONFIRMED, CAMPAIGN.md 2026-07-08; deepsrch_g
#          congested). Override with `sbatch -A <acct>` if directed.
# DTYPE:   GIGALENS_X64 is NOT set here -- 22_run_cell sets x64 per process from
#          the registry dtype, so T2 (f64) and T3 (f32) cells co-exist on the
#          node. Priority-fusion is disabled by default (A100 livelock policy,
#          confirmed needed; CAMPAIGN.md staging). runtime.setup_process_env
#          keeps a pre-existing --xla_disable_hlo_passes verbatim.
# LEDGER:  append the job row (id + est A100-h) to CAMPAIGN.md BEFORE reading
#          results. Budget: P2c <= 45 A100-h; HARD STOP 100 total.
#
# Usage:
#   sbatch -A cosmo_g slurm/p2c_matrix.slurm                 # kind=matrix
#   sbatch -A cosmo_g --export=ALL,P2C_KIND=all slurm/p2c_matrix.slurm
#   sbatch -A cosmo_g --export=ALL,P2C_KIND=matrix,P2C_SEEDS=0 ...  # 1-seed smoke
set -uo pipefail
module load python
source "$HOME/claude-giga-lens/venv/bin/activate"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export XLA_FLAGS="--xla_gpu_autotune_level=0 --xla_disable_hlo_passes=priority-fusion"
cd "$HOME/claude-giga-lens/repo/reproductions/claude-giga-lens"

PY=python
KIND="${P2C_KIND:-matrix}"
SEEDS="${P2C_SEEDS:-0,1,2}"
NGPU="${P2C_NGPU:-4}"
GLNT_FLAG="${P2C_NO_GLNT:+--no-glnt}"
LOGDIR="data/results/p2c_logs"
mkdir -p "$LOGDIR" data/results

mapfile -t JOBS < <("$PY" slurm/gen_p2c_manifest.py --kind "$KIND" \
                    --seeds "$SEEDS" $GLNT_FLAG)
echo "[p2c] ${#JOBS[@]} jobs, $NGPU GPU lanes, kind=$KIND seeds=$SEEDS"
printf '[p2c] %s\n' "${JOBS[@]}"

run_lane() {   # $1 = gpu/lane index
  local lane="$1" idx=0 j kind dt rest tag rc=0
  for j in "${JOBS[@]}"; do
    if (( idx % NGPU == lane )); then
      read -r kind dt rest <<< "$j"
      tag=$(echo "$rest" | tr ' /' '__' | tr -cd 'A-Za-z0-9_.-' | cut -c1-80)
      echo "[lane $lane gpu $lane] ($dt) $kind: $rest"
      if [ "$kind" = "cell" ]; then
        CUDA_VISIBLE_DEVICES=$lane $PY 22_run_cell.py $rest \
            > "$LOGDIR/L${lane}_${idx}_${tag}.log" 2>&1 || rc=1
      else   # script (23 / 24)
        CUDA_VISIBLE_DEVICES=$lane $PY $rest \
            > "$LOGDIR/L${lane}_${idx}_${tag}.log" 2>&1 || rc=1
      fi
    fi
    idx=$((idx+1))
  done
  return $rc
}

pids=()
for lane in $(seq 0 $((NGPU-1))); do run_lane "$lane" & pids+=($!); done
rc=0
for p in "${pids[@]}"; do wait "$p" || rc=1; done
echo "=== P2c DONE (rc=$rc). per-job logs in $LOGDIR ; results in data/results ==="
exit $rc

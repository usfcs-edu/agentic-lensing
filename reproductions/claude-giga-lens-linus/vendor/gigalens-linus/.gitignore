# Keep personal root-level work untracked by default, but preserve current repository structure.
# Allow shared-work contents explicitly.
/*
!/.gitignore
!/README.rst
!/LICENSE
!/pyproject.toml
!/setup.py
!/tox.ini
!/demo-multinode/
!/demos/
!/docs/

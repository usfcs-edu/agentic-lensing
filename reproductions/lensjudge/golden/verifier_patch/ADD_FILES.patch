+}
+
+// What each role is shown. The composite is the run's 6-panel JPG with its footer removed
+// (the footer carried the id, coordinates and r-mag). Panels, north up / east left:
+//   (a) normal 10"  (b) deep 10"  (c) colour 10"        [gray layout: (c) = 10" radial-profile SUBTRACTION]
+//   (d) deep 3.5"   (e) colour 3.5"                     [gray layout: (e) = normal-stretch 3.5" zoom]
+//   (f) deflector-subtracted 3.5" (a CIRCULAR radial-profile subtraction about the stamp centre)
+const LAYOUT_NOTE = `Each item carries "layout": "color" (two bands) or "gray" (one band). In the
+gray layout panel (c) is a 10" radial-profile SUBTRACTION, not a colour image, and panel (e)
+is a normal-stretch 3.5" zoom. Panel (f) (and (c) in the gray layout) is a CIRCULAR
+radial-profile subtraction about the stamp centre: on any elliptical, barred or inclined
+galaxy it leaves a four-lobed butterfly / bowtie and concentric rings, and on an off-centre
+deflector a dipole - properties of the subtraction, evidence neither for nor against a lens.
+Four yellow ticks mark the catalogued galaxy; a 1" bar sits in the first panel of each row.
+North up, East left; NE=top-left, NW=top-right, SE=bottom-left, SW=bottom-right. Position-angle
+spans run from pa_deg_from to pa_deg_to in the North-through-East (increasing) direction.
+BLINDING: read NOTHING but the job file and the image path(s) it lists for each item - not
+other files under data/verify/views/, not results/, not inspections.csv, not earlier verdicts,
+and do not crop, re-render or fetch anything with Bash; the view you were given is the
+complete evidence set, exactly as in the lensjudge evaluation of these prompts.`
+
+const VIEW = {
+  advocate: `Each item has "id", "image" (the full composite, footer removed; all six panels
+(a)-(f)), "layout", and "context" (a 20" deep+colour pair, or null). ${LAYOUT_NOTE}`,
+  artifact: `Each item has "id", "image" (the full composite, footer removed; all six panels
+(a)-(f) — you are the only critic shown panel (f)), "layout", "evidence_items" (the
+advocate's numbered items, each located by panel / r_arcsec / pa_deg_from..pa_deg_to) and
+"advocate_scale_class". ${LAYOUT_NOTE}`,
+  geometry: `Each item has "id", "image" (a strip of panels (b) deep 10", (d) deep 3.5" and
+(e) 3.5" zoom, each upscaled 2x, plus a 20" context pair when available — panel (f), the
+subtraction, is NOT shown to you), "layout", "evidence_items" (the advocate's numbered
+items, each located by panel / r_arcsec / pa_deg_from..pa_deg_to) and "advocate_scale_class".
+${LAYOUT_NOTE}`,
+  morphology: `Each item has "id", "image" (a strip of panels (c) colour 10", (d) deep 3.5"
+and (e) colour 3.5", upscaled 2x; in the gray layout (a) normal 10", (d) and (e), because (c)
+is a subtraction there — no subtraction panel is ever shown to you), "layout", "evidence_items"
+(the advocate's numbered items, each located by panel / r_arcsec / pa_deg_from..pa_deg_to)
+and "advocate_scale_class". ${LAYOUT_NOTE}`,
+  arbitrator: `Each item has "id", "image" (the full composite, footer removed), "layout",
+"advocate" (the evidence scorer's full record) and "critics" (the critics' full records).
+${LAYOUT_NOTE}`,
+}
+
+const RECORD = {
+  advocate: `{"id":"...","persona":"advocate",
+ "criteria":{"source_contrast":0-10,"low_surface_brightness":0-10,"curvature":0-10,"counter_image":0-10,"arc_morphology":0-10},
+ "items":[{"k":1,"what":"...","panel":"a|b|c|d|e|f|ctx","r_arcsec":1.3,"pa_deg_from":40,"pa_deg_to":170,"visible_in_direct":true,"criteria":[3,5]}],
+ "arc_radius_arcsec":null|number,"arc_pa_span_deg":null|[from,to],"counter_image_pos":null|{"r_arcsec":..,"pa_deg":..},
+ "centre_of_curvature_offset_arcsec":null|number,"scale_class":"galaxy|group|cluster|none",
+ "n_red_neighbours_10as":int,"bcg_like_halo":bool,"deflector_is_centre":bool,
+ "p_evidence":0-1,"nothing_because":"","notes":"one sentence"}`,
+  critic: `{"id":"...","persona":"<your role>","no_opinion":bool,
+ "no_opinion_reason":null|"outside_competence|feature_not_in_my_views|image_quality",
+ "alternative":null|"spiral_arm|ring_galaxy|shell_tidal|merger|edge_on_disk|companion_projection|star_forming_clump|diffraction_spike|detector_artifact|subtraction_residual|psf_wing|scale_tension|other",
+ "alternative_desc":"...","location":null|{"r_arcsec_from":..,"r_arcsec_to":..,"pa_deg_from":..,"pa_deg_to":..},
+ "accounts_for":[k,...],"leaves_standing":[k,...],"refutation_strength":0-1,
+ "measured":null|{...},"scale_class":null|"galaxy|group|cluster|none","notes":"point at pixels"}`,
+  arbitrator: `{"id":"...","persona":"arbitrator",
+ "rulings":[{"persona":"artifact|geometry|morphology","ruling":"upheld|partial|overruled","covers":[k,...],"why":"..."}],
+ "surviving_items":[k,...],"letter_llm":"A|B|C|D","scale_class_final":"galaxy|group|cluster|none",
+ "needs_human":bool,"rationale":"one paragraph that points at pixels"}`,
+}
+
+function prompt(job) {
+  const role = job.split('_')[0]
+  if (!BRIEFS[role]) throw new Error(`unknown role in job name: ${job}`)
+  const record = role === 'advocate' ? RECORD.advocate
+    : role === 'arbitrator' ? RECORD.arbitrator : RECORD.critic
+  const persona = role
+  return `${BRIEFS[role]}
+
+STEP 1. Read the job file: ${BASE}/data/verify/${job}.json
+${VIEW[role]}
+Use the Read tool on EVERY image listed in the job file, and on nothing else.
+
+STEP 2. Produce one record per item, from the pixels. Use the whole range of every
+numeric field; a precise "nothing in my competence fits" is as valuable as a precise
+refutation.
+
+STEP 3. Write results with the Write tool to:
+  ${BASE}/results/verdicts/verify_${job}.jsonl
+One JSON object per line, one per item, in job order, each exactly of the form:
+${record}
+with "persona" set to "${persona}" and "id" copied from the item. Every item must get
+exactly one line. No other keys. Then return the JSON summary
+{"job":"${job}","n_written":N,"n_no_opinion":N,"n_named":N,"note":"..."}.`
+}
+
+phase('Verify')
+const results = await pipeline(
+  JOBS,
+  (j) => agent(prompt(j), { label: `verify:${j}`, phase: 'Verify', schema: SCHEMA }),
+)
+
+const ok = results.filter(Boolean)
+return {
+  jobs_requested: JOBS.length,
+  jobs_returned: ok.length,
+  lines_written: ok.reduce((s, r) => s + (r.n_written || 0), 0),
+  no_opinion: ok.reduce((s, r) => s + (r.n_no_opinion || 0), 0),
+  named: ok.reduce((s, r) => s + (r.n_named || 0), 0),
+}

+// GENERATED by lensjudge/golden/make_verifier_patch.py on 2026-08-23 — do not hand-edit the
+// briefs: the lensjudge runner and this workflow must send byte-identical persona text.
+// Each FILES entry is one prompts/personas/jwst_v1/<name>.md verbatim (sha16 of the file text).
+
+const A = typeof args === 'string' ? JSON.parse(args) : args
+const BASE = A.base
+// jobs may be given explicitly, or compactly as {prefix, from, to} ranges
+const JOBS = A.jobs
+  ? A.jobs
+  : (A.ranges || []).flatMap((r) => {
+      const out = []
+      for (let i = r.from; i <= r.to; i++) out.push(`${r.prefix}${i}`)
+      return out
+    })
+
+const SCHEMA = {
+  type: 'object',
+  required: ['job', 'n_written'],
+  properties: {
+    job: { type: 'string' },
+    n_written: { type: 'integer' },
+    n_no_opinion: { type: 'integer' },
+    n_named: { type: 'integer' },

reproductions/huang-2020/data/cutouts_fits_dr9/
reproductions/huang-2020/data/cutouts_jpeg_dr9/
# Model checkpoint can be regenerated (or downloaded once published)
reproductions/huang-2020/data/checkpoint_best.pt

# Data
# Bare pattern: ignores every directory named `data`, at any depth.
# A few small, curated data PRODUCTS are force-added past this rule (`git add -f`) so a
# result can be reproduced from the repo alone. Negation rules (`!data/...`) cannot work
# here -- git will not descend into an excluded directory -- and re-anchoring the pattern
# would un-ignore every nested reproductions/*/data/ dir. Currently force-added:
#   data/klc_clean250629ymh.csv                             known-lens catalog (KLC)
#   reproductions/claudenet/data/v3/dr11s_v4_new_candidates*.csv   v4 candidates +/- KLC
#   reproductions/claudenet/data/v3/dr11s_v4_new_candidates_noknown_report.json
#   reproductions/huang-2020/data/*.csv                      (pre-existing)
data


# Python bytecode caches
__pycache__/
*.pyc

# Claude Code
.claude


# stray Wave-2 dependency install log (regenerable)
reproductions/.wave2_deps_install.log

# LaTeX build artifacts under any papers/ dir — regenerable by rebuilding
# main.tex. Scoped to papers/ so the tracked .log/.out run logs elsewhere
# (experiments/, reproductions/*) are unaffected. The compiled main.pdf is
# intentionally NOT ignored.
**/papers/*.aux
**/papers/*.bbl
**/papers/*.blg
**/papers/*.log
**/papers/*.out
**/papers/*.toc
**/papers/*.fls
**/papers/*.fdb_latexmk
**/papers/*.synctex.gz
**/papers/*.nav
**/papers/*.snm
**/papers/*.vrb
**/papers/*.bcf
**/papers/*.run.xml
**/papers/*.lof
**/papers/*.lot
**/papers/*.idx
**/papers/*.ind
**/papers/*.ilg
**/papers/*.dvi
**/papers/*.brf

# macOS Finder cruft
.DS_Store

# playwright-cli session artifacts (local browser QA)
.playwright-cli/

# LaTeX listings-package artifact (papers builds)
reproductions/*/papers/*.listing

# MkDocs site (site/) — build output and CI-generated report pages.
# Hand-written content (site/docs/index.md, stylesheets, javascripts,
# assets, other/apple-silicon/index.md, mkdocs.yml, overrides/) IS tracked.
site/_site/
site/docs/current/
site/docs/reproductions/
site/docs/other/apple-silicon/huang-2020.md
site/docs/other/apple-silicon/huang-2021.md
site/docs/other/apple-silicon/redshifty.md

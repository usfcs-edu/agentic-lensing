{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroMarkLensAnnotation",
  "description": "One annotated astronomical image, lens profile. GENERATED from astromark-vocab/lens-1.0 \u2014 do not edit by hand. Flat (no $ref) and closed (additionalProperties false) so it can be used as a structured-output schema.",
  "x-generated-from": "astromark-vocab/lens-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "system",
    "marks"
  ],
  "properties": {
    "schema": {
